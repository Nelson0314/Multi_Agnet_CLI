{
  "name": "multi-agent-cli",
  "version": "0.1.0",
  "description": "One window for all Claude Code and Codex sessions in a project: up to 6 terminals side by side, usage and context dashboard, separate Claude and Codex accounts, one-step account switching when usage runs out.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/postinstall.js",
    "shortcut": "node scripts/create-shortcut.js",
    "icons": "electron scripts/build-icons.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^44.5.1"
  },
  "license": "MIT",
  "productName": "Multi-Agent CLI",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nelson0314/Multi_Agnet_CLI.git"
  }
}
